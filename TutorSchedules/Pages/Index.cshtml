@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using TutorSchedules.Utilities
@model IndexModel
@{
  ViewData["Title"] = "Dashboard";
}

<div class="container">
  <div class="row">
    <form method="post" class="shadow-lg p-3" >
      <div class="mb-2">
        <div class="btn-group" role="group" aria-label="Lookup">
          @foreach (var (mode, label) in Model.Modes)
          {
            <input type="radio" class="btn-check" name="Mode" id="Mode@(mode)" value="@mode" checked="@(Model.Mode == mode)" onchange="this.form.submit()"/>
            <label class="btn btn-outline-primary" for="Mode@(mode)">@label</label>
          }
        </div>
      </div>
      <label asp-for="SubjectId">Subject:</label>
      <select asp-for="SubjectId" asp-items="Model.SubjectList" type="text" value="@Model.Subject?.Name" onchange="this.form.submit()"></select>
      <div class="mt-2 @(Model.UseCustomTime ? "" : "d-none")">
        <label asp-for="CustomWeekDay">Weekday</label>
        <select asp-for="CustomWeekDay" asp-items="Model.OpenWeekDays"></select>
        <span><label asp-for="CustomTime">Time:</label></span>
        <input asp-for="CustomTime" type="time" value="@Model.CustomTime?.ToString("HH:mm")"/>
        <span class="@(Model.Mode == DashboardMode.Appointment ? "" : "d-none")">
          <span class="ms-2">Appointment length:</span>
          <input asp-for="AppointmentHours" type="number" min="0" max="12" style="width: 4em"/>
          <label asp-for="AppointmentHours">hr</label>
          <input asp-for="AppointmentMinutes" type="number" min="0" max="59" step="5" style="width: 4em"/>
          <label asp-for="AppointmentMinutes">min</label>
        </span>
      </div>
      <button type="submit" class="btn btn-success my-2">Update List</button>
    </form>
  </div>
  <div class="row shadow-lg my-4 p-3">
    @if (Model.AppointmentLength > TimeSpan.Zero)
    {
      <h1>@Model.ActiveTutors.Count Tutors available @Model.TimeToUse.ToString("h:mm tt") - @Model.TimeToUse.Add(Model.AppointmentLength).ToString("h:mm tt") on @Model.WeekdayToUse</h1>
    }
    else
    {
      <h1>@Model.ActiveTutors.Count Tutors available at @Model.TimeToUse.ToString("h:mm tt") on @Model.WeekdayToUse</h1>
    }
    <div class="col">
      <table class="table table-hover">
        <thead>
        <tr>
          <th>Name</th>
          <th>Arrival Time</th>
          <th>Departure Time</th>
          @if (Model.ShowSubject)
          {
            <th>@Model.Subject.Name Comfort Level</th>
          }
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.ActiveTutors)
        {
          <tr class="">
            <td>@row.TutorName</td>
            <td>@row.ArrivalDisplay</td>
            <td>@row.DepartureString</td>
            @if (Model.ShowSubject)
            {
              <td style="background-color: @ComfortColors.GetColor(row.SubjectConfidence); border-radius: 5px; ">@(row.SubjectConfidence is null ? "?" : $"{row.SubjectConfidence.Value}")</td>
            }
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
  @if (Model.OutOfCenterTutors.Any())
  {
    <div class="row shadow-lg my-4 p-3 text-muted">
      <h4>@Model.OutOfCenterTutors.Count Scheduled, but out of the center</h4>
      <div class="col">
        <table class="table table-sm">
          <thead>
          <tr>
            <th>Name</th>
            <th>Where</th>
            <th>Time Out</th>
            <th>Returns to Center</th>
            @if (Model.ShowSubject)
            {
              <th>@Model.Subject.Name Comfort Level</th>
            }
          </tr>
          </thead>
          <tbody>
          @foreach (var row in Model.OutOfCenterTutors)
          {
            <tr>
              <td>@row.TutorName</td>
              <td>@row.Location</td>
              <td>@row.TimeOutDisplay</td>
              <td>@row.ReturnDisplay</td>
              @if (Model.ShowSubject)
              {
                <td style="background-color: @ComfortColors.GetColor(row.SubjectConfidence); border-radius: 5px; ">@(row.SubjectConfidence is null ? "?" : $"{row.SubjectConfidence.Value}")</td>
              }
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  }
</div>