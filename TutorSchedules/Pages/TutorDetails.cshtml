@page "{TutorId:int}"
@using TutorSchedules.Utilities
@model TutorSchedules.Pages.TutorDetails

@{
  ViewData["Title"] = $"Details for {Model.Tutor.DisplayName}";
}

<div class="container">
  <div class="row">
    <h1>Tutor Profile: @Model.Tutor.DisplayName</h1>
  </div>
  
  <section class="row my-3 shadow p-3">
    <h2 class="text-decoration-underline">Edit Profile</h2>
    <form method="post">
      <div class="form-group row">
        <label asp-for="Tutor.Id" class="col-form-label col-sm-2">Id: </label>
        <div class="col-sm-10">
          <input type="number" asp-for="Tutor.Id" readonly class="form-control-plaintext" value="@Model.TutorId"/>
        </div>
      </div>
      <div class="form-group row">
        <label asp-for="Tutor.DisplayName" class="col-form-label col-sm-2">Full Name:</label>
        <div class="col-sm-10">
          <input type="text" class="form-control" asp-for="Tutor.DisplayName" value="@Model.Tutor.DisplayName"/>
          <span class="text-danger" asp-validation-for="Tutor.DisplayName"></span>
        </div>
      </div>
      <div class="justify-content-end">
        <a class="btn btn-secondary" asp-page="/TutorList">Back to List</a>
        <input type="submit" class="btn btn-success" value="Save Changes">
      </div>
    </form>
  </section>
  <section class="row" style="white-space: nowrap;" id="MainSchedule">
    <h2 class="text-decoration-underline">Schedule:</h2>
    @for (DayOfWeek day = DayOfWeek.Monday; day <= DayOfWeek.Saturday; day++)
    {
      <div class="col col-2 text-center shadow rounded" style="min-width: 200px;">
        <h3>@day</h3>
        @{ var scheduleForDay =
             Model.ScheduledTimes
               .Where(b => b.Weekday == day)
               .OrderBy(b => b.StartTime); }

        <table class="table table-hover">
          <thead>
          <tr>
            <th>Start Time</th>
            <th>End Time</th>
          </tr>
          </thead>
          <tbody>
          @if (scheduleForDay.Any())
          {
            @foreach (var block in scheduleForDay)
            {
              <tr>
                <td>@block.StartTime</td>
                <td>@block.EndTime</td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="2" class="fw-bold">Off</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </section>
  <section class="row my-3 shadow p-3" id="OutOfCenterSchedule">
    <h2 class="text-decoration-underline">Out of Center:</h2>
    <p class="text-muted">
      Times when @Model.Tutor.DisplayName is on the schedule above but working outside the main center
      (e.g. embedded in a class). The dashboard won't list them as available during these times.
    </p>
    @if (Model.OutOfCenterError is not null)
    {
      <div class="alert alert-danger">@Model.OutOfCenterError</div>
    }
    <table class="table table-hover">
      <thead>
      <tr>
        <th>Day</th>
        <th>Start Time</th>
        <th>End Time</th>
        <th>Where</th>
        <th>Remove</th>
      </tr>
      </thead>
      <tbody>
      @if (Model.OutOfCenterBlocks.Any())
      {
        @foreach (var block in Model.OutOfCenterBlocks)
        {
          <tr>
            <td>@block.Weekday</td>
            <td>@block.StartTime</td>
            <td>@block.EndTime</td>
            <td>@block.Location</td>
            <td>
              <form method="post" asp-page-handler="DeleteOutOfCenter" asp-route-TutorId="@Model.TutorId">
                <input type="hidden" name="blockId" value="@block.Id"/>
                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
              </form>
            </td>
          </tr>
        }
      }
      else
      {
        <tr>
          <td colspan="5" class="text-muted">None</td>
        </tr>
      }
      </tbody>
    </table>
    <form method="post" asp-page-handler="AddOutOfCenter" asp-route-TutorId="@Model.TutorId">
      <h5>Add Out of Center Time</h5>
      <div class="mb-2">
        @for (DayOfWeek day = DayOfWeek.Monday; day <= DayOfWeek.Saturday; day++)
        {
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="weekdays" value="@day" id="OutOfCenterDay-@day"/>
            <label class="form-check-label" for="OutOfCenterDay-@day">@day</label>
          </div>
        }
      </div>
      <div class="row g-2 align-items-end">
        <div class="col-auto">
          <label class="form-label" for="OutOfCenterStart">Start Time</label>
          <input class="form-control" type="time" name="startTime" id="OutOfCenterStart" required/>
        </div>
        <div class="col-auto">
          <label class="form-label" for="OutOfCenterEnd">End Time</label>
          <input class="form-control" type="time" name="endTime" id="OutOfCenterEnd" required/>
        </div>
        <div class="col">
          <label class="form-label" for="OutOfCenterLocation">Where</label>
          <input class="form-control" type="text" name="location" id="OutOfCenterLocation" maxlength="50" required
                 placeholder="e.g. Music building, Embedded in MATH-1314"/>
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-success">Add</button>
        </div>
      </div>
    </form>
  </section>
  <section class="row" id="EmbeddedSchedule">

  </section>
  <section class="row" id="ProfessionalHourSchedule">

  </section>
  <section class="row my-3" id="TutorOverlaps">
    <div class="col">
      <a class="btn btn-primary" asp-page="/TutorOverlaps" asp-route-TutorId="@Model.TutorId">Other Tutor Overlaps</a>
    </div>
  </section>
  <section class="row my-3 shadow" id="SubjectLevels">
    <div class="col">
      <h3 class="text-decoration-underline">Subject Comfort Levels:</h3>
      <a class="btn btn-primary" asp-page="/EditConfidences" asp-route-TutorId="@Model.Tutor.Id">Edit Comfort Levels</a>
      <table class="table table-hover">
        <thead>
        <tr>
          <th>Subject Name</th>
          <th>Subject Number</th>
          <th>Comfort</th>
        </tr>
        </thead>
        @foreach (var comfort in Model.ComfortValues)
        {
          <tr>

            <td>@comfort.Subject.Name</td>
            <td>@comfort.Subject.SubjectId</td>
            <td style="background-color: @ComfortColors.GetColor(comfort.Confidence); border-radius: 5px;">
              @(comfort.Confidence is null ? "?" : comfort.Confidence.Value)
            </td>
          </tr>
        }
      </table>
    </div>
  </section>
</div>

@section Scripts {
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}